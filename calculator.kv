#:import dp kivy.metrics.dp
#:import safe_area safe_area.safe_area

<CustomTextInput@TextInput>:
    text: ''
    font_size: min(self.height * 0.3, self.width * 0.45)
    size_hint: None, None
    size: root.parent.width * 3.5, root.parent.height * 1.5
    multiline: False
    readonly: True
    background_color: app.theme_input_background
    foreground_color: app.theme_input_text
    font_name: 'assets/font/CODE2000.TTF'

    canvas.before:
        Color:
            rgba: app.theme_border
        Line:
            rounded_rectangle: (self.x, self.y, self.width, self.height, 5)
            width: 2

<NumberButton>:
    text:
        (root.limbu_numbers.get(str(root.number_value), '') + '\n' +
        root.nepali_numbers.get(str(root.number_value), '') + '  ' +
        str(root.number_value))
    font_size: min(self.height * 0.3, self.width * 0.45)
    color: app.theme_text
    background_color: (0, 0, 0, 0)
    background_normal: ''
    on_press: app.root.get_screen('main').children[0].add_number(root.number_value)

    canvas.before:
        Color:
            rgba: root.border_color
        Line:
            rounded_rectangle: (self.x, self.y, self.width, self.height, 10)
            width: 2

<NumberPadContainer>:
    orientation: 'vertical'
    safe_area_enabled: True
    base_padding: 0, 0, 0, 0
    western_display: western_display
    limbu_display: limbu_display
    nepali_display: nepali_display

    BoxLayout:
        orientation: 'vertical'
        size_hint: (1, 0.2)
        spacing: dp(5)
        padding: dp(8)

        BoxLayout:
            orientation: 'vertical'
            size_hint: (1, 0.4)
            ScrollView:
                do_scroll_x: True
                do_scroll_y: False
                bar_width: dp(1)
                bar_color: [0, 0.5, 0.8, 1]
                CustomTextInput:
                    id: limbu_display

        BoxLayout:
            orientation: 'vertical'
            size_hint: (1, 0.4)
            ScrollView:
                do_scroll_x: True
                do_scroll_y: False
                bar_width: dp(1)
                bar_color: [0, 0.5, 0.8, 1]
                CustomTextInput:
                    id: nepali_display

        BoxLayout:
            orientation: 'vertical'
            size_hint: (1, 0.4)
            ScrollView:
                do_scroll_x: True
                do_scroll_y: False
                bar_width: dp(1)
                bar_color: [0, 0.5, 0.8, 1]
                CustomTextInput:
                    id: western_display

    Label:
        text: ''
        size_hint: (1, 0.002)

    GridLayout:
        cols: 4
        spacing: dp(5)
        size_hint: (1, 0.4)
        padding: dp(8)

        NumberButton:
            number_value: 0
            border_color: (0.4, 0.6, 0.8, 1)

        Button:
            text: 'AC'
            font_size: min(self.height * 0.3, self.width * 0.45)
            background_color: (0, 0, 0, 0)
            color: (0.7, 0.1, 0.1, 1)
            background_normal: ''
            on_press: root.clear_all(self)
            canvas.before:
                Color:
                    rgba: (0.7, 0.3, 0.3, 1)
                Line:
                    rounded_rectangle: (self.x, self.y, self.width, self.height, 10)
                    width: 1.01
        Button:
            text: 'DEL'
            font_size: min(self.height * 0.3, self.width * 0.45)
            background_color: (0, 0, 0, 0)
            color: (0.7, 0.1, 0.1, 1)
            background_normal: ''
            on_press: root.delete(self)
            canvas.before:
                Color:
                    rgba: (0.7, 0.3, 0.3, 1)
                Line:
                    rounded_rectangle: (self.x, self.y, self.width, self.height, 10)
                    width: 1.2
        Button:
            text: '⌫'
            font_size: min(self.height * 0.4, self.width * 0.45)
            background_color: (0, 0, 0, 0)
            color: (0.7, 0.1, 0.1, 1)
            font_name: 'assets/font/CODE2000.TTF'
            background_normal: ''
            on_press: root.backspace(self)
            canvas.before:
                Color:
                    rgba: (0.7, 0.3, 0.3, 1)
                Line:
                    rounded_rectangle: (self.x, self.y, self.width, self.height, 10)
                    width: 1.01

        NumberButton:
            number_value: 1
            border_color: (0.4, 0.6, 0.8, 1)

        NumberButton:
            number_value: 2
            border_color: (0.4, 0.6, 0.8, 1)

        NumberButton:
            number_value: 3
            border_color: (0.4, 0.6, 0.8, 1)

        Button:
            text: "÷"
            on_release: root.add_operator('÷')
            size_hint: 1, 1
            font_size: min(self.height * 0.3, self.width * 0.45)
            color: (0, 0, 1, 1)
            background_color: (0, 0, 0, 0)
            background_normal: ''
            canvas.before:
                Color:
                    rgba: (0/255, 128/255, 255/255, 1)
                Line:
                    rounded_rectangle: (self.x, self.y, self.width, self.height, 10)
                    width: 1.01

        NumberButton:
            number_value: 4
            border_color: (0.4, 0.6, 0.8, 1)

        NumberButton:
            number_value: 5
            border_color: (0.4, 0.6, 0.8, 1)

        NumberButton:
            number_value: 6
            border_color: (0.4, 0.6, 0.8, 1)

        Button:
            text: "×"
            on_release: root.add_operator('×')
            size_hint: 1, 1
            font_size: min(self.height * 0.3, self.width * 0.45)
            color: (0, 0, 1, 1)
            background_color: (0, 0, 0, 0)
            background_normal: ''
            canvas.before:
                Color:
                    rgba: (0/255, 128/255, 255/255, 1)
                Line:
                    rounded_rectangle: (self.x, self.y, self.width, self.height, 10)
                    width: 1.01

        NumberButton:
            number_value: 7
            border_color: (0.4, 0.6, 0.8, 1)

        NumberButton:
            number_value: 8
            border_color: (0.4, 0.6, 0.8, 1)

        NumberButton:
            number_value: 9
            border_color: (0.4, 0.6, 0.8, 1)

        Button:
            text: "-"
            on_release: root.add_operator('-')
            size_hint: 1, 1
            font_size: min(self.height * 0.4, self.width * 0.45)
            color: (0, 0, 1, 1)
            background_color: (0, 0, 0, 0)
            background_normal: ''
            canvas.before:
                Color:
                    rgba: (0/255, 128/255, 255/255, 1)
                Line:
                    rounded_rectangle: (self.x, self.y, self.width, self.height, 10)
                    width: 1.01

        Button:
            text: "."
            on_release: root.add_decimal()
            size_hint: 1, 1
            font_size: min(self.height * 0.4, self.width * 0.45)
            color: (0, 0, 1, 1)
            background_color: (0, 0, 0, 0)
            background_normal: ''
            canvas.before:
                Color:
                    rgba: (0/255, 128/255, 255/255, 1)
                Line:
                    rounded_rectangle: (self.x, self.y, self.width, self.height, 10)
                    width: 1.01
        Button:
            text: "%"
            on_release: root.add_percent()
            size_hint: 1, 1
            font_size: min(self.height * 0.3, self.width * 0.45)
            color: (0, 0, 1, 1)
            background_color: (0, 0, 0, 0)
            background_normal: ''
            canvas.before:
                Color:
                    rgba: (0/255, 128/255, 255/255, 1)
                Line:
                    rounded_rectangle: (self.x, self.y, self.width, self.height, 10)
                    width: 1.01
        Button:
            text: "+"
            on_release: root.add_operator('+')
            size_hint: 1, 1
            font_size: min(self.height * 0.3, self.width * 0.45)
            color: (0, 0, 1, 1)
            background_color: (0, 0, 0, 0)
            background_normal: ''
            canvas.before:
                Color:
                    rgba: (0/255, 128/255, 255/255, 1)
                Line:
                    rounded_rectangle: (self.x, self.y, self.width, self.height, 10)
                    width: 1.01
        Button:
            text: "="
            on_release: root.calculate_result()
            size_hint: 1, 1
            font_size: min(self.height * 0.4, self.width * 0.45)
            color: (0, 0, 1, 1)
            background_color: (0, 0, 0, 0)
            background_normal: ''
            canvas.before:
                Color:
                    rgba: (0/255, 128/255, 255/255, 1)
                Line:
                    rounded_rectangle: (self.x, self.y, self.width, self.height, 10)
                    width: 1.01

    MDFloatLayout:
        size_hint: (1, 0.05)
        md_bg_color: (0.4, 0.6, 0.8, 1)

        MDIconButton:
            icon: 'history'
            pos_hint: {'center_y': 0.5, 'center_x': 0.06}
            theme_icon_color: "Custom"
            icon_color: 1, 1, 1, 1
            background_color: 0, 0, 0, 0
            background_normal: ''
            on_release: root.show_history()

        MDIconButton:
            id: help
            icon: 'dots-horizontal-circle-outline'
            pos_hint: {'center_y': 0.5, 'center_x': 0.94}
            theme_icon_color: "Custom"
            icon_color: 1, 1, 1, 1
            background_color: 0, 0, 0, 0
            background_normal: ''
            on_release: root.show_help()


<HelpScreen>:
    name: 'help'

    SafeAreaBoxLayout:
        orientation: "vertical"
        safe_area_enabled: True
        base_padding: 0, 0, 0, 0
        spacing: dp(5)

        MDTopAppBar:
            title: "Settings & Information"
            md_bg_color: (0.4, 0.6, 0.8, 1)
            elevation: 4
            left_action_items: [["book-open-outline", lambda x: root.open_bottom_sheet()]]
            right_action_items: [["close", lambda x: root.go_back()]]

        MDScrollView:
            MDBoxLayout:
                orientation: "vertical"
                adaptive_height: True
                padding: dp(16)
                spacing: dp(12)

                MDLabel:
                    text: "Menu"
                    font_style: "H5"
                    size_hint_y: None
                    height: self.texture_size[1]

                MDCard:
                    orientation: 'vertical'
                    adaptive_height: True
                    padding: dp(10)
                    radius: [15]
                    md_bg_color: app.theme_surface
                    line_color: app.theme_border
                    line_width: dp(0.3)

                    MDLabel:
                        text: "Theme"
                        font_style: "H5"
                        size_hint_y: None
                        height: self.texture_size[1]

                    TwoLineIconListItem:
                        id: appearance_item
                        text: "Apperance:"
                        secondary_text: root.get_theme_description()
                        on_release: root.toggle_theme()
                        IconLeftWidget:
                            icon: "theme-light-dark"
                            icon: root.get_theme_icon()

                MDGridLayout:
                    cols: 1
                    adaptive_height: True
                    spacing: dp(1)
                    padding: dp(1)

                    MDLabel:
                        text: "Learn Sirijanga Numbers"
                        font_style: "H5"
                        size_hint_y: None
                        height: self.texture_size[1]

                    MDList:
                        OneLineIconListItem:
                            text: "Reading Numbers"
                            on_press: root.open_limbu_number_trace()
                            IconLeftWidget:
                                icon: "read"
                                on_press: root.open_limbu_number_trace()

                        OneLineIconListItem:
                            text: "Writing Numbers"
                            on_press: root.open_limbu_number_trace()
                            IconLeftWidget:
                                icon: "pencil"
                                on_press: root.open_limbu_number_trace()

                        OneLineIconListItem:
                            text: "Quiz"
                            on_press: root.open_limbu_number_trace()
                            IconLeftWidget:
                                icon: "alpha-q-box-outline"   #alpha-q-circle-outline
                                on_press: root.open_limbu_number_trace()

                MDList:
                    MDLabel:
                        text: '[b]Communicate[/b]'
                        font_style: 'H5'
                        theme_text_color: "Primary"
                        halign: "left"
                        markup: True
                        size_hint_y: None
                        height: self.texture_size[1]

                    TwoLineIconListItem:
                        text: "Update"
                        secondary_text: "Update for latest features"
                        on_press: root.update_khanit()
                        IconLeftWidget:
                            icon: "upload-outline"
                            on_press: root.update_khanit()

                    TwoLineIconListItem:
                        text: "Share the App"
                        secondary_text: "Share app with your friends & family."
                        on_press: root.share_khanit()
                        IconLeftWidget:
                            icon: "share-variant-outline"
                            on_press: root.share_khanit()

                    TwoLineIconListItem:
                        text: "Rate Us"
                        secondary_text: "Rate this App by giving STARS."
                        on_press: root.rate_khanit()
                        IconLeftWidget:
                            icon: "star-circle-outline"
                            on_press: root.rate_khanit()

                    TwoLineIconListItem:
                        text: "Feedback"
                        secondary_text: "Questions or Feedback? Contact Us."
                        on_press: root.open_feedback_email()
                        IconLeftWidget:
                            icon: "email-outline"

                Widget:

                MDCard:
                    orientation: 'vertical'
                    adaptive_height: True
                    padding: dp(10)
                    radius: [15]
                    md_bg_color: 0,0,1,0.5

                    MDLabel:
                        text: "Khanit:"
                        font_style: "H5"
                        halign: "left"
                        size_hint_y: None
                        height: self.texture_size[1]

                    MDLabel:
                        text: "Tri-Language Smart Calculator"
                        font_style: "H5"
                        halign: "center"
                        size_hint_y: None
                        height: self.texture_size[1]

                    MDLabel:
                        text: "Supports Kirat, Nepali & English\n"
                        font_style: "Body1"
                        halign: "center"
                        theme_text_color: "Secondary"
                        size_hint_y: None
                        height: self.texture_size[1]

                    MDCard:
                        orientation: 'vertical'
                        adaptive_height: True
                        padding: dp(3)
                        radius: [15]

                        MDLabel:
                            text: "This unique trilingual Khanit app brings everything together on a single screen, making calculations easy to understand, compare, and use.\n\nWhether you're at home, school, work, or managing a business, the app makes everyday calculations simple, clear, convenient, and accessible."
                            font_style: "Body1"
                            halign: "center"
                            size_hint_y: None
                            height: self.texture_size[1]

                MDList:
                    pos_hint: {"center_x": 0.5, "center_y": 0.5}
                    MDLabel:
                        text: '[b]IT Training Center[/b]'
                        font_style: 'H5'
                        theme_text_color: "Primary"
                        halign: "center"
                        markup: True
                        size_hint_y: None
                        height: self.texture_size[1]
                    MDLabel:
                        text: "LABA is a leading IT training provider, offering flexible learning options — in-person classes, on-site training, and online courses — all delivered directly by top global industry experts."
                        adaptive_height: True
                        font_name: "assets/font/CODE2000.TTF"
                        markup: True
                        theme_text_color: "Primary"
                        font_style: "Body1"
                        halign: "center"
                        size_hint_y: None
                        height: self.texture_size[1]

                    TwoLineListItem:
                        text: "www.labanepal.com"
                        secondary_text: "Visit Us To Believe Us!"
                        on_press: root.open_laba_link()

                MDCard:
                    orientation: "vertical"
                    adaptive_height: True
                    radius: [15]
                    md_bg_color: 0.69, 0.85, 0.98, 1
                    line_color: 1.00, 0.60, 0.00, 1
                    line_width: 2
                    style: "outlined"

                    MDBoxLayout:
                        orientation: 'vertical'
                        adaptive_height: True
                        padding: [dp(15),dp(15),dp(1),dp(1)]
                        spacing: dp(10)
                        MDLabel:
                            text: 'Mobile App Development'
                            bold: True
                            font_name: "assets/font/CODE2000.TTF"
                            markup: True
                            font_style: "H5"
                            halign: "center"
                            size_hint_y: None
                            height: self.texture_size[1]

                        MDLabel:
                            text: "LABA Nepal UK designs and develops intuitive mobile applications that deliver seamless user experiences across iOS and Android platforms. Our team builds apps with modern frameworks and scalable architecture, ensuring high performance, security, and adaptability. From concept to deployment, we provide end?to?end solutions including UI/UX design, backend integration, and ongoing support, helping businesses engage customers and expand their digital presence."
                            adaptive_height: True
                            font_name: "assets/font/CODE2000.TTF"
                            markup: True
                            theme_text_color: "Primary"
                            font_style: "Body1"
                            halign: "center"
                            size_hint_y: None
                            height: self.texture_size[1]

                        MDRectangleFlatIconButton:
                            id: read_full_atmananda
                            icon: "arrow-right"
                            text: "More..."
                            theme_text_color: "Custom"
                            text_color: [1.00, 0.60, 0.00, 1]
                            icon_color: [1.00, 0.60, 0.00, 1]
                            pos_hint: {"right": 1}
                            line_color: 1.00, 0.60, 0.00, 1
                            line_width: 2
                            style: "outlined"
                            on_release: root.open_labauk_link()

                MDList:
                    MDGridLayout:
                        cols: 2
                        adaptive_height: True
                        spacing: dp(20)
                        padding: dp(20)

                        MDLabel:
                            text: '[b]Artificial Intelligence Solutions[/b]'
                            pos_hint: {"center_x": .5, "center_y": .5}
                            font_style: 'H6'
                            markup: True
                            theme_text_color: "Custom"
                            text_color: 0/255, 128/255, 128/255, 1
                            halign: 'center'

                        MDIconButton:
                            icon: "arrow-right-circle-outline"
                            pos_hint: {"center_x": .5, "center_y": .5}
                            on_release: root.open_labauk_AIlink()

                MDCard:
                    orientation: "vertical"
                    adaptive_height: True
                    radius: [15]
                    md_bg_color: 1.00, 0.88, 0.70, 0.5
                    line_color: 0.00, 0.59, 0.53, 1
                    line_width: 2
                    style: "outlined"

                    MDBoxLayout:
                        orientation: 'vertical'
                        adaptive_height: True
                        padding: [dp(15),dp(15),dp(1),dp(1)]
                        spacing: dp(10)
                        MDLabel:
                            text: 'IT Audit & Compliance'
                            bold: True
                            font_name: "assets/font/CODE2000.TTF"
                            markup: True
                            font_style: "H5"
                            halign: "center"
                            size_hint_y: None
                            height: self.texture_size[1]

                        MDLabel:
                            text: "Cube Technologies provides comprehensive cybersecurity solutions to help businesses strengthen digital resilience. From penetration testing and infrastructure design to compliance and forensics, we ensure your operations stay secure, compliant, and future-ready."
                            adaptive_height: True
                            font_name: "assets/font/CODE2000.TTF"
                            markup: True
                            font_style: "Body1"
                            halign: "center"
                            size_hint_y: None
                            height: self.texture_size[1]

                        MDRectangleFlatIconButton:
                            icon: "arrow-right"
                            text: "More..."
                            theme_text_color: "Custom"
                            text_color: [0.00, 0.59, 0.53, 1]
                            icon_color: [0.00, 0.59, 0.53, 1]
                            pos_hint: {"right": 1}
                            line_color: 0.00, 0.59, 0.53, 1
                            line_width: 2
                            style: "outlined"
                            on_release: root.open_cube_link()

    MDBottomSheet:
        id: bottom_sheet
        type: "modal"
        adaptive_height: True
        max_opening_height: dp(600)
        default_opening_height: dp(550)

        MDBottomSheetContent:
            id: sheet_content
            orientation: "vertical"
            padding: dp(16), dp(16), dp(16), dp(16)
            spacing: dp(8)

            MDBoxLayout:
                size_hint_y: None
                height: dp(56)

                MDLabel:
                    text: "Choose an Option"
                    font_style: "H6"
                    bold: True
                    valign: "center"

                MDIconButton:
                    icon: "close"
                    pos_hint: {"center_y": .5}
                    on_release: root.close_bottom_sheet()

            MDSeparator:

            MDScrollView:
                id: sheet_scroll
                size_hint_y: None
                height: min(dp(410), self.parent.height)
                size_hint_x: 1
                do_scroll_x: False
                do_scroll_y: True

                MDList:
                    id: sheet_list
                    size_hint_y: None
                    height: self.minimum_height
                    size_hint_x: 1

            MDSeparator:

            Widget:
                size_hint_y: None
                height: dp(8)

<LimbuNumberTrace>:
    SafeAreaBoxLayout:
        orientation: "vertical"
        safe_area_enabled: True
        base_padding: 0, 0, 0, 0
        spacing: dp(5)

        MDTopAppBar:
            title: "Learning Sirijanga Numbers"
            elevation: 4
            left_action_items: [["arrow-left", lambda x: root.close_screen()]]

        TabbedPanel:
            id: number_tabs
            do_default_tab: False
            tab_width: dp(145)
            tab_height: dp(48)
            allow_stretch: False
            border: [dp(1), dp(1), dp(1), dp(1)]

            TabbedPanelItem:
                text: "Sirijanga Numbers"
                color: 1, 1, 1, 1

                MDScrollView:
                    MDBoxLayout:
                        orientation: "vertical"
                        adaptive_height: True
                        padding: dp(12)
                        spacing: dp(12)

                        MDLabel:
                            text: "Sirijanga Numbers"
                            font_style: "H4"
                            halign: "center"
                            size_hint_y: None
                            height: self.texture_size[1]
                            theme_text_color: "Custom"
                            text_color: 1, 1, 1, 1

                        MDLabel:
                            text: "Learn the Sirijanga/Limbu digits from 0 to 9"
                            font_style: "Body1"
                            halign: "center"
                            size_hint_y: None
                            height: self.texture_size[1]
                            theme_text_color: "Custom"
                            text_color: 1, 1, 1, 1

                        Widget:

                        MDCard:
                            orientation: "vertical"
                            size_hint_y: None
                            height: dp(280)
                            padding: dp(5)
                            spacing: dp(15)
                            radius: [20]
                            md_bg_color: app.theme_surface

                            MDGridLayout:
                                cols: 2
                                padding: dp(5)
                                spacing : dp(5)

                                MDLabel:
                                    id: trace_number
                                    text: "᥆"
                                    font_name: "assets/font/CODE2000.TTF"
                                    font_size: dp(96)
                                    halign: "right"
                                    valign: "middle"
                                    size_hint_y: .65
                                    size_hint_x: None
                                    width: dp(100)
                                MDLabel:
                                    id: trace_word
                                    text: "ᤜᤥᤵ"
                                    font_name: "assets/font/CODE2000.TTF"
                                    font_size: dp(35)
                                    halign: "left"
                                    valign: "center"

                            MDLabel:
                                id: trace_number_nepali
                                text: "०"
                                font_name: "assets/font/CODE2000.TTF"
                                font_size: dp(48)
                                halign: "center"
                                size_hint_y: .15

                            MDLabel:
                                id: trace_number_english
                                text: "0"
                                font_size: dp(48)
                                halign: "center"
                                size_hint_y: .2

                        MDGridLayout:
                            cols: 5
                            adaptive_height: True
                            spacing: dp(8)

                            MDRaisedButton:
                                text: "0 | ०"
                                font_name: "assets/font/CODE2000.TTF"
                                on_release:
                                    root.select_number(0)
                                    root.play_audio()
                                size_hint: 1,1

                            MDRaisedButton:
                                text: "1 | १"
                                font_name: "assets/font/CODE2000.TTF"
                                on_release:
                                    root.select_number(1)
                                    root.play_audio()
                                size_hint: 1,1

                            MDRaisedButton:
                                text: "2 | २"
                                font_name: "assets/font/CODE2000.TTF"
                                on_release:
                                    root.select_number(2)
                                    root.play_audio()
                                size_hint: 1,1

                            MDRaisedButton:
                                text: "3 | ३"
                                font_name: "assets/font/CODE2000.TTF"
                                on_release:
                                    root.select_number(3)
                                    root.play_audio()
                                size_hint: 1,1

                            MDRaisedButton:
                                text: "4 | ४"
                                font_name: "assets/font/CODE2000.TTF"
                                on_release:
                                    root.select_number(4)
                                    root.play_audio()
                                size_hint: 1,1

                            MDRaisedButton:
                                text: "5 | ५"
                                font_name: "assets/font/CODE2000.TTF"
                                on_release:
                                    root.select_number(5)
                                    root.play_audio()
                                size_hint: 1,1

                            MDRaisedButton:
                                text: "6 | ६"
                                font_name: "assets/font/CODE2000.TTF"
                                on_release:
                                    root.select_number(6)
                                    root.play_audio()
                                size_hint: 1,1

                            MDRaisedButton:
                                text: "7 | ७"
                                font_name: "assets/font/CODE2000.TTF"
                                on_release:
                                    root.select_number(7)
                                    root.play_audio()
                                size_hint: 1,1

                            MDRaisedButton:
                                text: "8 | ८"
                                font_name: "assets/font/CODE2000.TTF"
                                on_release:
                                    root.select_number(8)
                                    root.play_audio()
                                size_hint: 1,1

                            MDRaisedButton:
                                text: "9 | ९"
                                font_name: "assets/font/CODE2000.TTF"
                                on_release:
                                    root.select_number(9)
                                    root.play_audio()
                                size_hint: 1,1

                        MDBoxLayout:
                            size_hint_y: None
                            height: dp(55)
                            spacing: dp(15)

                            MDRaisedButton:
                                text: "PREVIOUS"
                                size_hint_x: .5
                                on_release:
                                    root.previous_number()
                                    root.play_audio()

                            MDRaisedButton:
                                text: "NEXT"
                                size_hint_x: .5
                                on_release:
                                    root.next_number()
                                    root.play_audio()

            TabbedPanelItem:
                text: "Write Numbers"
                color: 1, 1, 1, 1

                #MDScrollView:
                MDBoxLayout:
                    orientation: "vertical"
                    adaptive_height: True
                    padding: dp(12), dp(10), dp(12), dp(20)
                    spacing: dp(10)

                    MDLabel:
                        text: "Write / Trace Sirijanga Number"
                        font_style: "H5"
                        halign: "center"
                        size_hint_y: None
                        height: dp(40)
                        theme_text_color: "Custom"
                        text_color: 1, 1, 1, 1

                    MDBoxLayout:
                        size_hint_y: None
                        height: dp(40)
                        spacing: dp(10)
                        orientation: "horizontal"

                        MDLabel:
                            id: progress_label
                            text: "Stroke 0/1"
                            font_size: sp(15)
                            halign: "center"
                            size_hint_y: None
                            height: dp(35)
                            theme_text_color: "Custom"
                            text_color: 1, 1, 1, 1
                            size_hint_x: 0.30
                            valign: "middle"
                            text_size: self.size

                        MDProgressBar:
                            id: progress_bar
                            value: 0
                            size_hint_y: None
                            height: dp(5)
                            pos_hint: {"center_y": 0.5}
                            color: 1, 1, 1, 1

                    MDCard:
                        orientation: "horizontal"
                        size_hint_y: None
                        height: dp(75)
                        padding: dp(8)
                        spacing: dp(5)
                        radius: [dp(15)]
                        md_bg_color: 0.12, 0.12, 0.12, 1

                        MDLabel:
                            id: show_number_sirijanga
                            text: "᥆"
                            font_name: "assets/font/CODE2000.TTF"
                            font_size: dp(96)
                            halign: "center"
                            valign: "center"
                            size_hint_x: .25
                            theme_text_color: "Custom"
                            text_color: 1, 1, 1, 1

                        MDBoxLayout:
                            orientation: "vertical"
                            spacing: dp(1)
                            size_hint_x: 0.50

                            MDLabel:
                                id: num_name
                                text: "Hop (Zero)"
                                font_size: sp(17)
                                bold: True
                                halign: "left"
                                valign: "middle"
                                text_size: self.width, None
                                size_hint_y: 0.60
                                theme_text_color: "Custom"
                                text_color: 1, 1, 1, 1

                            MDLabel:
                                id: stroke_info
                                text: "Strokes: 0/1"
                                font_size: sp(14)
                                valign: "middle"
                                text_size: self.width, None
                                theme_text_color: "Custom"
                                text_color: 1, 1, 1, 1

                        MDIconButton:
                            id: play_btn
                            icon: "play-circle"
                            icon_size: dp(40)
                            size_hint_x: .20
                            pos_hint: {"center_y": 0.5}
                            theme_icon_color: "Custom"
                            icon_color: 1, 1, 1, 1
                            on_release: root.play_audio()

                    MDCard:
                        orientation: "vertical"
                        size_hint_y: None
                        height: dp(270)
                        padding: dp(10)
                        radius: [dp(18)]
                        md_bg_color: 0.95, 0.95, 0.95, 1

                        LimbuTracePad:
                            id: trace_pad
                            size_hint: 1, 1

                    MDLabel:
                        text: "Use your finger or mouse to trace the number above."
                        halign: "center"
                        size_hint_y: None
                        height: dp(35)
                        theme_text_color: "Custom"
                        text_color: 1, 1, 1, 1

                    MDBoxLayout:
                        orientation: "horizontal"
                        size_hint_y: None
                        height: dp(52)
                        spacing: dp(8)

                        MDRaisedButton:
                            text: "UNDO"
                            size_hint_x: .25
                            on_release: root.undo_trace()

                        MDRaisedButton:
                            text: "CLEAR"
                            size_hint_x: .25
                            on_release: root.clear_trace()

                        MDRaisedButton:
                            text: "PREVIOUS"
                            size_hint_x: .25
                            on_release: root.previous_number()

                        MDRaisedButton:
                            text: "NEXT"
                            size_hint_x: .25
                            on_release:
                                root.next_number()
                                root.clear_trace()

            TabbedPanelItem:
                text: "Quiz"
                color: 1, 1, 1, 1

                MDScrollView:
                    MDBoxLayout:
                        orientation: "vertical"
                        adaptive_height: True
                        padding: dp(12)
                        spacing: dp(12)

                        MDLabel:
                            text: "\n\nPractice Sirijanga Numbers"
                            font_style: "H5"
                            halign: "center"
                            markup: True
                            size_hint_y: None
                            height: self.texture_size[1]
                            theme_text_color: "Custom"
                            text_color: 1, 1, 1, 1

                        MDLabel:
                            id: quiz_question
                            text: " "
                            font_style: "H4"
                            halign: "center"
                            theme_text_color: "Custom"
                            text_color: 1, 1, 1, 1

                        MDLabel:
                            text: "Choose the correct Kirat Sirijanga number:"
                            font_style: "Caption"
                            halign: "center"
                            size_hint_y: None
                            height: dp(40)
                            theme_text_color: "Custom"
                            text_color: 1, 1, 1, 1

                        MDGridLayout:
                            id: answer_grid
                            cols: 2
                            adaptive_height: True
                            spacing: dp(8)

                        MDLabel:
                            id: quiz_result
                            text: ""
                            font_name: "assets/font/CODE2000.TTF"
                            font_size: sp(24)
                            halign: "center"
                            valign: "middle"
                            text_size: self.width, None
                            size_hint_y: None
                            height: dp(60)
                            theme_text_color: "Custom"
                            text_color: 1, 1, 1, 1

                        MDLabel:
                            id: quiz_score_label
                            text: ""
                            font_name: "assets/font/CODE2000.TTF"
                            halign: "center"
                            font_style: "H6"
                            size_hint_y: None
                            height: dp(40)
                            theme_text_color: "Custom"
                            text_color: 1, 1, 1, 1

                        MDRaisedButton:
                            text: "NEXT QUESTION"
                            size_hint: 1,1
                            pos_hint: {"center_x": .5}
                            on_release: root.next_quiz_question()

                        MDRaisedButton:
                            id: quit_quiz
                            text: "Quit Quiz"
                            size_hint: 1,1
                            pos_hint: {"center_x": .5}
                            on_release: root.quit_quiz()

                        Widget:
                            size_hint_y: None
                            height: dp(20)